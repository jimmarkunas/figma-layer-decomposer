{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-layer-decomposer/layer-manifest.schema.json",
  "title": "Figma Layer Decomposer Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mockup_id", "canvas", "source", "targets", "sequence"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "mockup_id": {"type": "string", "minLength": 1},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "immutable"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "immutable": {"const": true},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/target"}
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_key": {"type": ["string", "null"]},
        "editable_frame_node_id": {"type": ["string", "null"]},
        "master_reference_node_id": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "core_bounds", "approved_zone", "halo_px", "mask", "output", "figma_placement"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["clean_plate", "raster_extract", "screen_extract", "other"]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "core_bounds": {"$ref": "#/$defs/bounds"},
        "approved_zone": {"$ref": "#/$defs/bounds"},
        "halo_px": {"type": "integer", "minimum": 0},
        "mask": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "mode"],
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "mode": {"type": "string", "enum": ["full_canvas", "bounded"]},
            "bounds": {"$ref": "#/$defs/bounds"}
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_file", "preview_file", "qa_report"],
          "properties": {
            "canonical_file": {"type": "string", "minLength": 1},
            "preview_file": {"type": "string", "minLength": 1},
            "qa_report": {"type": "string", "minLength": 1}
          }
        },
        "figma_placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "destination_group", "bounds"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "destination_group": {"type": "string", "minLength": 1},
            "bounds": {"$ref": "#/$defs/bounds"}
          }
        }
      }
    }
  }
}
